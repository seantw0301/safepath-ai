{
    "name": "seantw0301/safepath-ai",
    "description": "SafePath AI - measure home access hazards, draft LTC 2.0 subsidy packages, verify fixes (Meta Global AI Developer Hackathon 2026)",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.3",
        "ext-pdo": "*",
        "ext-curl": "*",
        "ext-gd": "*",
        "ext-mbstring": "*"
    },
    "autoload": {
        "psr-4": {
            "SafePath\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SafePath\\Tests\\": "tests/"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^11"
    },
    "config": {
        "platform": {
            "php": "8.3.0"
        }
    }
}
