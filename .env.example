APP_ENV=local
APP_URL=http://localhost:8080
# Set when the app lives under a sub-path, e.g. /safepath
APP_BASE_PATH=
# Public host: read-only demos; uploads off unless LIVE_UPLOADS=1, then capped per 24 hours
JUDGE_MODE=0
LIVE_UPLOADS=0
LIVE_UPLOADS_PER_DAY=3
# A running job with no heartbeat for this long is retried, up to JOB_MAX_ATTEMPTS
JOB_TIMEOUT_SECONDS=300
JOB_MAX_ATTEMPTS=3

# sqlite = zero-setup local fallback; mysql = MySQL 9.0.1
DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=33062
DB_NAME=safepath
DB_USER=safepath
DB_PASS=

# Meta Model API (https://dev.meta.ai)
META_API_BASE=https://api.meta.ai/v1
META_API_KEY=
META_SAM_MODEL=sam-3.1
META_SPARK_MODEL=muse-spark-1.3
META_TRANSCRIBE_MODEL=muse-voice-transcribe-1.0

STORAGE_PATH=storage
FFMPEG_BIN=ffmpeg
SAMTOOL_BIN=helpers/samtool/.venv/bin/python helpers/samtool/samtool.py

# Hard usage cap (Meta spend limit only alerts). Costs are estimates per unit.
USAGE_BUDGET_USD=120
USAGE_MAX_REQUESTS=5000
COST_SAM_IMAGE=0.01
COST_SAM_FRAME=0.002
COST_UPLOAD=0
COST_SPARK=0.02
COST_IMAGE=0.01
COST_TRANSCRIBE=0.01
