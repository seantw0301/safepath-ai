# Root install: https://safepath.example.com/
# Replace safepath.example.com and /var/www/safepath; check your PHP-FPM socket path.
server {
    listen 443 ssl;
    server_name safepath.example.com;
    # ssl_certificate ...; ssl_certificate_key ...;

    root /var/www/safepath/public;
    client_max_body_size 320m;

    location / {
        try_files $uri /index.php$is_args$args;
    }
    location = /index.php {
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root/index.php;
        fastcgi_read_timeout 120s;
        fastcgi_pass unix:/run/php/php-fpm.sock;
    }
}

# Sub-path install instead: https://example.com/safepath/ with APP_BASE_PATH=/safepath in .env.
# Put this inside your existing server block:
#
# location /safepath/ {
#     client_max_body_size 320m;
#     include fastcgi_params;
#     fastcgi_param SCRIPT_FILENAME /var/www/safepath/public/index.php;
#     fastcgi_param REQUEST_URI $request_uri;
#     fastcgi_read_timeout 120s;
#     fastcgi_pass unix:/run/php/php-fpm.sock;
# }
